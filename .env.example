# Frontend runtime
VITE_DEMO_MODE=true

# Java API and OIDC entry points. Tokens and client secrets never belong here.
VITE_API_BASE_URL=/api/v1
# Required outside demo mode. Configure only after a same-origin BFF login
# endpoint exists; the current resource-server backend does not supply one.
# VITE_OIDC_LOGIN_PATH=/oauth2/authorization/<registration-id>
VITE_OIDC_LOGOUT_PATH=/api/v1/auth/logout
VITE_BACKEND_DEV_URL=http://localhost:8080
# Set automatically by `npm run dev:all`; do not enable for a deployed build.
# VITE_LOCAL_DEV_AUTH=true
# VITE_LOCAL_DEV_ACCESS_TOKEN=<ephemeral local token>

# Additive frontend rollout flags
VITE_FEATURE_LEGACY_FIXED_COST=true
VITE_FEATURE_WORKFORCE_GOVERNANCE=false
VITE_FEATURE_GREYTHR=false
VITE_FEATURE_LINEAR=false
VITE_FEATURE_EMAIL_REPLY_INGESTION=false
