{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance.example.internal/schemas/evidence-manifest-v1.json",
  "title": "Monthly Procurement Evidence Manifest",
  "description": "Manifest for one immutable version of a monthly invoice evidence package. It intentionally excludes salary, employee cost, markup and rate-card calculations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_id",
    "package_version",
    "engagement_id",
    "billing_month",
    "generated_at",
    "generated_by",
    "readiness_state",
    "source_snapshots",
    "documents",
    "manifest_sha256"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "package_version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_package_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "engagement_id": {
      "type": "string",
      "format": "uuid"
    },
    "engagement_month_id": {
      "type": "string",
      "format": "uuid"
    },
    "billing_month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "BLOCKED",
        "READY_FOR_CONFIRMATION",
        "CONFIRMED",
        "READY_FOR_PROCUREMENT",
        "PROCUREMENT_EXCEPTION",
        "SUPERSEDED"
      ]
    },
    "exception_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_type",
          "snapshot_id",
          "version",
          "captured_at",
          "sha256"
        ],
        "properties": {
          "snapshot_type": {
            "type": "string",
            "enum": [
              "ROSTER",
              "ALLOCATION",
              "ATTENDANCE",
              "LEAVE",
              "DELIVERABLE_PLAN",
              "LINEAR_PLAN_TIME",
              "LINEAR_MONTH_END",
              "DELIVERY_CERTIFICATION",
              "BUSINESS_CONFIRMATION",
              "AUDIT_EXPORT",
              "INVOICE_COPY",
              "OTHER"
            ]
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_system": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "document_type",
          "file_name",
          "media_type",
          "byte_size",
          "storage_path",
          "sha256"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "COVER_SUMMARY",
              "ROSTER",
              "ATTENDANCE_REGISTER",
              "LEAVE_SUMMARY",
              "ALLOCATION_REGISTER",
              "DELIVERABLE_BASELINE",
              "LINEAR_SNAPSHOT",
              "CERTIFICATION_SUMMARY",
              "CONFIRMATION_EVIDENCE",
              "EXCEPTION_REPORT",
              "AUDIT_EXPORT",
              "INVOICE",
              "MANIFEST",
              "OTHER"
            ]
          },
          "file_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "storage_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_record_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "confirmation_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "invoice_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
