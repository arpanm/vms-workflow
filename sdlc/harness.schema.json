{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "codegenModel",
    "reviewModel",
    "featureRoot",
    "requiredPlanningArtifacts",
    "requiredCompletedArtifacts",
    "qualityCommands",
    "features"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "codegenModel": { "type": "string", "minLength": 1 },
    "reviewModel": { "type": "string", "minLength": 1 },
    "documentationModel": { "type": "string", "minLength": 1 },
    "featureRoot": { "type": "string", "minLength": 1 },
    "requiredPlanningArtifacts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "uniqueItems": true
    },
    "requiredCompletedArtifacts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "uniqueItems": true
    },
    "qualityCommands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "directory", "phase", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2}$" },
          "directory": { "type": "string", "minLength": 1 },
          "phase": { "type": "integer", "minimum": 0 },
          "state": { "enum": ["planned", "active", "completed", "blocked"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
